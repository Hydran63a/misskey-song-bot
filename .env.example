# このファイルを .env という名前でコピーし、値を設定してください。
# .env は絶対に Git にコミットしないでください。

# Misskey サーバーの URL（末尾の / は不要）
MISSKEY_HOST=https://misskey.example.com
# Misskey のアクセストークン（「ノートを作成・削除する」権限が必要）
MISSKEY_TOKEN=

# 投稿の公開範囲: public / home / followers / specified（省略時 public）
# MISSKEY_VISIBILITY=public

# ===== 楽曲ソース（使うものだけ設定。設定したソースはすべて同期されます） =====

# --- YouTube ---
# YouTube Data API v3 の API キー
YOUTUBE_API_KEY=
# 楽曲を取得する YouTube プレイリストの ID（URL の list= の後ろの部分）
YOUTUBE_PLAYLIST_ID=

# データベースの保存先（省略時 data/songs.db）
# DB_PATH=data/songs.db
